@model CollegePortal.Services.CollegeStore
@{
    ViewData["Title"] = "Обзор";
}
<header class="page-heading">
    <div><p class="eyebrow">@Model.AcademicYear–@(Model.AcademicYear + 1) учебный год</p><h1>@Model.CollegeName</h1><p class="subtitle">Добро пожаловать, @User.FindFirst("DisplayName")?.Value</p></div>
    <span class="tag">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
</header>
<div class="stats-grid">
    <div class="stat"><span class="stat-label">Студенты</span><strong class="stat-value">@Model.Students.Count</strong></div>
    <div class="stat"><span class="stat-label">Преподаватели</span><strong class="stat-value">@Model.Teachers.Count</strong></div>
    <div class="stat"><span class="stat-label">Учебные группы</span><strong class="stat-value">@Model.Groups.Count</strong></div>
    <div class="stat"><span class="stat-label">Посещаемость</span><strong class="stat-value">@Model.Attendance.GetStatistics().Percent%</strong></div>
</div>
<div class="content-grid">
    <section class="panel">
        <div class="panel-heading"><h2>Последние оценки</h2><a class="subtle" asp-action="Grades">Открыть журнал →</a></div>
        <div class="table-wrap"><table class="data-table"><thead><tr><th>Студент</th><th>Предмет</th><th>Оценка</th><th>Дата</th></tr></thead><tbody>
        @foreach (var grade in Model.GradeBook.Grades.OrderByDescending(g => g.Date).Take(5))
        {
            <tr><td>@grade.StudentName</td><td>@grade.Subject</td><td><span class="tag">@grade.Value</span></td><td>@grade.Date.ToString("dd.MM.yyyy")</td></tr>
        }
        </tbody></table></div>
    </section>
    <section class="panel">
        <h2>Разделы портала</h2>
        <div class="quick-links">
            <a class="quick-link" asp-action="Students">Студенты <span>↗</span></a>
            <a class="quick-link" asp-action="Teachers">Преподаватели <span>↗</span></a>
            <a class="quick-link" asp-action="Groups">Учебные группы <span>↗</span></a>
            <a class="quick-link" asp-action="Grades">Электронный журнал <span>↗</span></a>
            <a class="quick-link" asp-action="Attendance">Посещаемость <span>↗</span></a>
            @if (User.IsInRole("Admin"))
            {
                <a class="quick-link" asp-action="Admin">Панель администратора <span>↗</span></a>
            }
        </div>
    </section>
</div>